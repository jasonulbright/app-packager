<#
Vendor: TODO-VENDOR
App: TODO-APPLICATION
CMName: TODO-CMNAME
VendorUrl: https://TODO
UpdateCadenceDays: 30

.SYNOPSIS
    Packager template for PSADT (PowerShell App Deployment Toolkit) v3 or v4
    wrapped applications. Copy to Packagers/package-<appname>.ps1, fill the
    TODO markers, and it runs.

.DESCRIPTION
    Wraps an existing per-app PSADT folder ("wrap-a-wrap"): a toolkit a vendor
    or predecessor already built, with the installer under Files\ and the app
    logic in the toolkit entry script. This packager stages that folder as the
    MECM content, records SHA256 hashes over the whole tree (subfolders
    included) for package integrity verification, and creates an MECM
    Application whose Script deployment type invokes the toolkit directly:

      v4: Invoke-AppDeployToolkit.exe -DeploymentType Install
          (powershell.exe -File Invoke-AppDeployToolkit.ps1 when no exe)
      v3: Deploy-Application.exe -DeploymentType "Install"

    Test-PsadtLayout (AppPackagerCommon) detects the generation and builds the
    command lines; the stage manifest carries them via InstallCommandLine /
    UninstallCommandLine, which New-MECMApplicationFromManifest honors instead
    of the default install.bat/uninstall.bat wrappers. DeployMode is left to
    the toolkit (Interactive with a user session, NonInteractive without) so
    the close-app/defer UX works; pass -DeployMode Silent to suppress all UI.

    Pin the toolkit version per app: refresh the toolkit inside
    ToolkitSourcePath deliberately, bump AppVersion, and re-run. Mixing v3 and
    v4 files in one folder breaks the toolkit.

.REQUIREMENTS
    - PowerShell 5.1 (7+ only if the wrapped v4 toolkit targets pwsh)
    - ConfigMgr Admin Console installed (ConfigurationManager PowerShell module available)
    - RBAC permissions to create Applications and Deployment Types
    - Write access to FileServerPath
#>

param(
    [string]$SiteCode = "MCM",
    [string]$Comment = "",
    [string]$FileServerPath = "\\fileserver\sccm$",
    [string]$DownloadRoot = "C:\temp\ap",
    # TODO: point at the per-app PSADT folder (contains the toolkit entry
    # script and Files\ with the installer).
    [string]$ToolkitSourcePath = "TODO-\\fileserver\packaging$\PSADT\TODO-APPLICATION",
    # TODO: the wrapped application's version. PSADT toolkits do not
    # self-report one; keep this in sync with the installer in Files\.
    # (v3: $appVersion in Deploy-Application.ps1; v4: AppScriptVersion in
    # Invoke-AppDeployToolkit.ps1's $adtSession block.)
    [string]$AppVersion = "TODO-1.0.0",
    [ValidateSet('', 'Interactive', 'Silent', 'NonInteractive')]
    [string]$DeployMode = '',
    [int]$EstimatedRuntimeMins = 30,
    [int]$MaximumRuntimeMins = 90,
    [string]$LogPath,
    [switch]$GetLatestVersionOnly,
    [switch]$StageOnly,
    [switch]$PackageOnly,
    [switch]$VerboseLog
)

Import-Module "$PSScriptRoot\..\AppPackagerCommon.psd1" -Force
Initialize-Logging -LogPath $LogPath -VerboseLogging:$VerboseLog

if ($StageOnly -and $PackageOnly) {
    Write-Log "-StageOnly and -PackageOnly cannot be used together." -Level ERROR
    exit 1
}

# --- Configuration ---
$VendorFolder = "TODO-VENDOR"
$AppFolder    = "TODO-APPLICATION"
$Publisher    = "TODO-PUBLISHER"

$BaseDownloadRoot = Join-Path $DownloadRoot $AppFolder

# --- Latest-only mode ---
if ($GetLatestVersionOnly) {
    if ($AppVersion -match '^TODO') {
        [Console]::Error.WriteLine("$AppFolder AppVersion is not set; edit the packager.")
        exit 1
    }
    Write-Output $AppVersion
    exit 0
}

# ---------------------------------------------------------------------------
# Stage phase
# ---------------------------------------------------------------------------

function Invoke-StagePsadt {
    Write-Log ""
    Write-Log ("=" * 60)
    Write-Log "$AppFolder (PSADT) - STAGE phase"
    Write-Log ("=" * 60)
    Write-Log ""

    if ($AppVersion -match '^TODO' -or $ToolkitSourcePath -match '^TODO') {
        throw "Fill the TODO markers first: -ToolkitSourcePath and -AppVersion."
    }
    if (-not (Test-Path -LiteralPath $ToolkitSourcePath)) {
        throw "Toolkit source not found: $ToolkitSourcePath"
    }

    $layout = Test-PsadtLayout -Path $ToolkitSourcePath -DeployMode $DeployMode
    Write-Log "PSADT generation             : $($layout.Generation)"
    Write-Log "Entry point                  : $($layout.EntryPoint)"
    Write-Log "Install command              : $($layout.InstallCommandLine)"
    Write-Log "Uninstall command            : $($layout.UninstallCommandLine)"
    Write-Log ""

    # --- Versioned local content folder: the full toolkit tree ---
    $localContentPath = Join-Path $BaseDownloadRoot $AppVersion
    if (Test-Path -LiteralPath $localContentPath) {
        Remove-Item -LiteralPath $localContentPath -Recurse -Force -ErrorAction Stop
    }
    Initialize-Folder -Path $localContentPath
    Copy-Item -Path (Join-Path $ToolkitSourcePath '*') -Destination $localContentPath -Recurse -Force -ErrorAction Stop
    Write-Log "Copied toolkit tree          : $localContentPath"

    # --- Write stage manifest (hashes cover the whole tree) ---
    $manifestPath = Join-Path $localContentPath "stage-manifest.json"
    Write-StageManifest -Path $manifestPath -ManifestData @{
        AppName              = $AppFolder
        Publisher            = $Publisher
        SoftwareVersion      = $AppVersion
        InstallerType        = "PSADT"
        InstallCommandLine   = $layout.InstallCommandLine
        UninstallCommandLine = $layout.UninstallCommandLine
        RunningProcess       = @()
        # TODO: detection. Registry example below; swap for File/Compound as
        # fits the wrapped installer (see AUTHORING.md detection preference
        # order). The toolkit does not provide detection - MECM needs it.
        Detection            = @{
            Type                = "RegistryKeyValue"
            RegistryKeyRelative = "SOFTWARE\TODO\TODO"
            ValueName           = "DisplayVersion"
            ExpectedValue       = $AppVersion
            Is64Bit             = $true
        }
    }

    Set-Content -LiteralPath (Join-Path $BaseDownloadRoot "staged-version.txt") -Value $AppVersion -Encoding ASCII -ErrorAction Stop

    Write-Log ""
    Write-Log "Stage complete               : $localContentPath"

    return $localContentPath
}

# ---------------------------------------------------------------------------
# Package phase
# ---------------------------------------------------------------------------

function Invoke-PackagePsadt {
    Write-Log ""
    Write-Log ("=" * 60)
    Write-Log "$AppFolder (PSADT) - PACKAGE phase"
    Write-Log ("=" * 60)
    Write-Log ""

    Initialize-Folder -Path $BaseDownloadRoot

    $versionFile = Join-Path $BaseDownloadRoot "staged-version.txt"
    if (-not (Test-Path -LiteralPath $versionFile)) {
        throw "Version marker not found - run Stage phase first: $versionFile"
    }
    $version = (Get-Content -LiteralPath $versionFile -Raw -ErrorAction Stop).Trim()

    $localContentPath = Join-Path $BaseDownloadRoot $version
    $manifestPath     = Join-Path $localContentPath "stage-manifest.json"
    $manifest = Read-StageManifest -Path $manifestPath

    Write-Log "AppName                      : $($manifest.AppName)"
    Write-Log "SoftwareVersion              : $($manifest.SoftwareVersion)"
    Write-Log "Install command              : $($manifest.InstallCommandLine)"
    Write-Log ""

    # --- Network share ---
    if (-not (Test-NetworkShareAccess -Path $FileServerPath)) {
        throw "Network root path not accessible: $FileServerPath"
    }

    $networkAppRoot = Get-NetworkAppRoot -FileServerPath $FileServerPath -VendorFolder $VendorFolder -AppFolder $AppFolder
    $networkContentPath = Join-Path $networkAppRoot $manifest.SoftwareVersion
    Initialize-Folder -Path $networkContentPath

    Write-Log "Network content path         : $networkContentPath"
    Write-Log ""

    # --- Copy staged tree to network (subfolders included; manifest excluded) ---
    foreach ($item in (Get-ChildItem -LiteralPath $localContentPath -Force -ErrorAction Stop)) {
        if ($item.Name -eq "stage-manifest.json") { continue }
        Copy-Item -LiteralPath $item.FullName -Destination (Join-Path $networkContentPath $item.Name) -Recurse -Force -ErrorAction Stop
    }
    Write-Log "Copied toolkit tree to network."

    # --- MECM application ---
    New-MECMApplicationFromManifest `
        -Manifest $manifest `
        -SiteCode $SiteCode `
        -Comment $Comment `
        -NetworkContentPath $networkContentPath `
        -EstimatedRuntimeMins $EstimatedRuntimeMins `
        -MaximumRuntimeMins $MaximumRuntimeMins
}

# --- Main ---
try {
    $startLocation = Get-Location

    if ($StageOnly) {
        Invoke-StagePsadt
    }
    elseif ($PackageOnly) {
        Invoke-PackagePsadt
    }
    else {
        Invoke-StagePsadt
        Invoke-PackagePsadt
    }

    Write-Log ""
    Write-Log "Script execution complete."
}
catch {
    Write-LogErrorRecord -ErrorRecord $_ -Context "package-psadt ($AppFolder)"
    Write-Log "SCRIPT FAILED: $($_.Exception.Message)" -Level ERROR
    exit 1
}
finally {
    Set-Location $startLocation -ErrorAction SilentlyContinue
}
